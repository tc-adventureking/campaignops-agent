# Copy to .env only if it does not exist; keep real keys out of source and chat.
# Main setup uses a model. Use demo only for offline demonstrations and tests.
AGENT_MODE=youtu
MODEL_BASE_URL=https://your-provider.example/v1
# Replace the endpoint and model ID with values enabled for your account.
MODEL_NAME=your-enabled-model-id
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_RETRIES=2
MODEL_RETRY_BASE_SECONDS=0.5
# Explicit same-provider fallback model IDs; no automatic switch to demo.
MODEL_FALLBACKS=[]
RUN_TIMEOUT_SECONDS=180
RETRIEVAL_TIMEOUT_SECONDS=3
MODEL_MAX_TOKENS=4096
DATA_DIR=data/generated
KNOWLEDGE_DIR=data/knowledge
MAX_QUERY_ROWS=200
MAX_RESULT_BYTES=262144
QUERY_TIMEOUT_SECONDS=5
MAX_TOOL_CALLS=8
MAX_CONCURRENT_RUNS=4
MAX_QUEUED_RUNS=8
DATABASE_BACKEND=duckdb
DATABASE_CONNECT_TIMEOUT_SECONDS=3
# For Compose storage profile: use the postgres service hostname. Keep admin DSN out of API.
POSTGRES_DSN=
POSTGRES_ADMIN_DSN=
POSTGRES_READER_PASSWORD=
REDIS_URL=
CACHE_NAMESPACE=campaignops:v2
CACHE_TTL_SECONDS=300
REDIS_TIMEOUT_SECONDS=0.3
# Optional operator password enables only the simulated budget workflow.
APPROVAL_API_KEY=
APPROVAL_ACTOR=local-operator
APPROVAL_TTL_SECONDS=600
TRACE_RETENTION_DAYS=30
# Single process, localhost and synthetic data. Model API key is not an operator password.
